{
  "name": "@ahmad/apple-style-mcp",
  "version": "2.0.0",
  "description": "Enterprise-grade Model Context Protocol (MCP) server for auditing, design tokens, and component scaffolding across macOS, iPadOS, and iOS (Apple HIG & Liquid Glass)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "apple-style-mcp": "dist/index.js",
    "desktop-style-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadeko2017/apple-style-mcp.git"
  },
  "homepage": "https://github.com/ahmadeko2017/apple-style-mcp#readme",
  "bugs": {
    "url": "https://github.com/ahmadeko2017/apple-style-mcp/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple-hig",
    "macos",
    "ipados",
    "ios",
    "liquid-glass",
    "swiftui",
    "tauri",
    "react",
    "design-tokens",
    "zero-shift"
  ],
  "author": "Ahmad Eko Kurniawan",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
